.godot/
# The Firebase plugin's own libraries sit beside the build template in android/firebase_*/ and are committed.
/android/build/
/android/.build_version

__pycache__/
*.pyc

/build/
/test-results/
/node_modules/

# Raw third-party downloads live in the private game-assets repo (faceplant/assets_incoming)
assets_incoming/

# export_presets.cfg IS committed: CI needs it. Keystore paths and passwords never go in it. Godot keeps
# them in .godot/export_credentials.cfg, and CI injects them at build time.
*.keystore
*.jks

# Rendered promo videos, made by the promo pipeline in video-making-skills
/out/
